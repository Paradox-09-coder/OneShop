# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneshop?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_NAME="OneShop ERP"
DEFAULT_LANGUAGE="uz"
DEFAULT_CURRENCY="UZS"
DEFAULT_EXCHANGE_RATE="12200"

# Seed defaults
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Bosh Administrator"

# Telegram bot (backend integration). Token from @BotFather, keep secret.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Umumiy Telegram guruh — avtomatik xabarlar (zakaz tayyor, yetkazildi va h.k.)
# shu guruhga boradi. Bo'sh bo'lsa, guruh xabarlari jim o'tkazib yuboriladi.
TELEGRAM_GROUP_CHAT_ID=""

# Cron himoya kaliti — /api/cron/* endpointlarini tashqi so'rovlardan himoya
# qiladi. Tashqi cron xizmati so'rov yuborganda shu qiymatni
# "x-cron-secret" header'ida (yoki ?secret= query'da) yuborishi kerak.
CRON_SECRET=""

# Gemini (Google AI Studio) — for future voice-message transcription (phase 2).
GEMINI_API_KEY=""
