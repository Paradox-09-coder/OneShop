// OneShop ERP — Unified schema
// Sources: iselll (sales/finance/installments) + belt-tech2 (production/CRM/rolls)
// See UNIFIED_ERP_ARCHITECTURE.md for the full rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Identity & RBAC
// ─────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  name         String
  email        String?     @unique
  password     String      // bcrypt hash
  role         Role        @default(USER)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  isActive     Boolean     @default(true)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee     Employee?
  sessions     Session[]
  logs         Log[]
  notifications Notification[]
  dashboardSettings UserDashboardSetting?
  paymentsCreated Payment[]  @relation("PaymentCreatedBy")
  paymentsVoided  Payment[]  @relation("PaymentVoidedBy")
  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]

  @@index([customRoleId])
}

enum Role {
  SUPER_ADMIN        // legacy
  ADMIN              // legacy
  MANAGER            // legacy
  USER               // legacy — default fallback
  RAHBAR             // director / CEO — full access
  SOTUVCHI           // seller — orders + clients + CRM
  SEX_MUDIRI         // production manager — manufacturing orders + warehouse
  OMBORCHI           // warehouse keeper — inventory + shipments
  BUXGALTER          // accountant — finance + reports
  TAMINOTCHI         // supplier — via Telegram, own shipments only
  MIJOZ              // client — via Telegram, own orders only
  HAYDOVCHI          // driver — via Telegram, own deliveries only
  // legacy synonyms kept for compat
  SELLER
  WAREHOUSE
  ACCOUNTANT
}

model CustomRole {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  mappedRole   Role     @default(USER)
  permissions  Json     @default("[]")   // ["orders.write", "warehouse.read", ...]
  routeAccess  Json     @default("[]")   // ["/buyurtmalar", "/moliya"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jwtHash   String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  Counterparties (polymorphic partner ledger)
// ─────────────────────────────────────────────────────────────

model Counterparty {
  id             String              @id @default(cuid())
  type           CounterpartyType
  name           String
  displayName    String?
  phone          String?
  phone2         String?
  email          String?
  telegram       String?
  inn            String?
  address        String?
  locationLat    Float?
  locationLng    Float?
  region         String?
  balanceValue   Float               @default(0)
  balanceCurrency Currency           @default(UZS)
  status         String              @default("active")
  notes          String?
  deletedAt      DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  clientProfile   ClientProfile?
  supplierProfile SupplierProfile?
  employee        Employee?

  ordersAsClient  Order[]             @relation("OrderClient")
  ordersAsSeller  Order[]             @relation("OrderSeller")
  ordersAssigned  Order[]             @relation("OrderAssigned")
  deliveriesPaid  Order[]             @relation("OrderDeliveryPaidTo")
  paymentsAsCounterparty Payment[]
  shipments       Shipment[]
  callLogs        CallLog[]
  crmHistory      CrmStageHistory[]
  counterpartyNotes CounterpartyNote[]
  extraExpenses   CounterpartyExpense[]

  @@index([type])
  @@index([deletedAt])
  @@index([phone])
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  EMPLOYEE
  FOUNDER
  LENDER
  OTHER
}

enum Currency {
  UZS
  USD
  EUR
  RUB
}

model ClientProfile {
  counterpartyId       String       @id
  counterparty         Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  customerKind         CustomerKind @default(RETAIL)
  rating               Int?
  funnel               CrmFunnel?
  stage                String?
  assignedEmployeeId   String?
  source               String?
  resaleScheduledAt    DateTime?
  currentDebtCache     Float        @default(0)
  // Credit limit (1-etap)
  creditLimit          Float?
  creditLimitCurrency  Currency     @default(UZS)
  creditLimitEnabled   Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

enum CustomerKind {
  RESELLER
  RETAIL
}

model SupplierProfile {
  counterpartyId       String       @id
  counterparty         Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  totalPurchasedCache  Float        @default(0)
  ordersCountCache     Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Employee {
  counterpartyId       String       @id
  counterparty         Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  userId               String?      @unique
  user                 User?        @relation(fields: [userId], references: [id])
  position             String?
  baseSalary           Float        @default(0)
  salaryCurrency       Currency     @default(UZS)
  salaryType           SalaryType   @default(FIXED)
  kpiPercentage        Float        @default(0)
  startDate            DateTime?
  attendance           Attendance[]
  payrollAccruals      PayrollAccrual[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

enum SalaryType {
  FIXED
  KPI
  MIXED
}

model CounterpartyNote {
  id             String       @id @default(cuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  text           String
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([counterpartyId])
}

model CounterpartyExpense {
  id             String       @id @default(cuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  expenseType    String
  amount         Float
  currency       Currency     @default(UZS)
  date           DateTime     @default(now())

  @@index([counterpartyId])
}

// ─────────────────────────────────────────────────────────────
//  Warehouses
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id        String     @id @default(cuid())
  name      String     @unique
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  catalogProducts CatalogProduct[]
  inventoryLots   InventoryLot[]
  inventoryRolls  InventoryRoll[]
  stockMovements  StockMovement[]
  transfersFrom   StockTransfer[]  @relation("TransferFrom")
  transfersTo     StockTransfer[]  @relation("TransferTo")
}

// ─────────────────────────────────────────────────────────────
//  Product Catalog & Inventory
// ─────────────────────────────────────────────────────────────

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  sortOrder Int               @default(0)
  status    String            @default("active")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  products  CatalogProduct[]

  @@index([parentId])
}

model CatalogProduct {
  id              String            @id @default(cuid())
  sku             String            @unique
  code            String?
  name            String
  displayName     String?
  categoryId      String?
  category        ProductCategory?  @relation(fields: [categoryId], references: [id])
  unitType        UnitType          @default(DONA)
  unitQuantity    Float             @default(1)
  baseCost        Float?
  baseCostCurrency Currency         @default(UZS)
  basePrice       Float?
  basePriceCurrency Currency        @default(UZS)
  minPrice        Float?
  minPriceCurrency Currency         @default(UZS)
  color           String?
  thicknessMm     Float?
  model           String?
  type            String?
  weight          Float?
  volume          Float?
  imageUrl        String?
  extraExpenses   Json?
  supplierId      String?
  warehouseId     String?
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])
  status          String            @default("active")
  lowStockThreshold Float           @default(0)
  // Mijozga sotiladigan tayyor mahsulotmi (true) yoki faqat retseptda
  // ishlatiladigan xomashyo (false)?  Xomashyo (bitum, folga, mel...)
  // "Yangi buyurtma" va "Kassa" mahsulot ro'yxatida ko'rinmasligi kerak —
  // ular faqat Retsept (BOM) ingredient sifatida tanlanadi.
  isSellable      Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lots            InventoryLot[]
  rolls           InventoryRoll[]
  remnants        Remnant[]
  stockMovements  StockMovement[]
  orderItems      OrderItem[]
  shipmentItems   ShipmentItem[]
  priceHistory    ProductPriceHistory[]
  recipes         Recipe[]
  usedInRecipes   RecipeIngredient[]  @relation("RecipeMaterial")
  transferItems   StockTransferItem[]

  @@index([categoryId])
  @@index([warehouseId])
  @@index([supplierId])
}

model ProductPriceHistory {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  field            String
  oldValue         Float?
  newValue         Float
  currency         Currency       @default(UZS)
  changedBy        String?
  changedAt        DateTime       @default(now())

  @@index([catalogProductId])
}

enum UnitType {
  DONA        // piece
  METR        // linear meter
  M2          // square meter
  MM          // millimeter (roll width)
  KG          // kilogram
  LITR        // liter
}

// Generic inventory lot (for non-roll goods)
model InventoryLot {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  qty              Float          @default(0)
  unitType         UnitType       @default(DONA)
  cost             Float?
  costCurrency     Currency       @default(UZS)
  price            Float?
  priceCurrency    Currency       @default(UZS)
  supplierId       String?
  invoiceNo        String?
  purchaseDate     DateTime?
  lowStockThreshold Float         @default(0)
  status           String         @default("active")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stockMovements   StockMovement[]

  @@index([catalogProductId])
  @@index([warehouseId])
}

// Specialized roll lot (Beltech roll-cutting)
model InventoryRoll {
  id                 String         @id @default(cuid())
  catalogProductId   String
  catalogProduct     CatalogProduct @relation(fields: [catalogProductId], references: [id])
  warehouseId        String?
  warehouse          Warehouse?     @relation(fields: [warehouseId], references: [id])
  totalWidthMm       Float
  totalLengthMm      Float
  remainingLengthMm  Float
  status             RollStatus     @default(AVAILABLE)
  batchNumber        String?
  rollNumber         String?
  supplierId         String?
  shipmentItemId     String?
  shipmentItem       ShipmentItem?  @relation(fields: [shipmentItemId], references: [id])
  receivedDate       DateTime?
  cost               Float?
  costCurrency       Currency       @default(UZS)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  remnants           Remnant[]      @relation("SourceRoll")
  orderItems         OrderItem[]
  stockMovements     StockMovement[]

  @@index([catalogProductId])
  @@index([status])
}

enum RollStatus {
  AVAILABLE
  RESERVED
  IN_USE
  DEPLETED
}

model Remnant {
  id                String         @id @default(cuid())
  catalogProductId  String
  catalogProduct    CatalogProduct @relation(fields: [catalogProductId], references: [id])
  sourceRollId      String?
  sourceRoll        InventoryRoll? @relation("SourceRoll", fields: [sourceRollId], references: [id])
  sourceOrderId     String?
  sourceOrder       Order?         @relation("SourceOrder", fields: [sourceOrderId], references: [id])
  widthMm           Float
  lengthMm          Float
  areaM2            Float
  status            String         @default("available")   // available | used
  usedInOrderId     String?
  usedInOrder       Order?         @relation("UsedInOrder", fields: [usedInOrderId], references: [id])
  offsetX           Float?
  offsetY           Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([catalogProductId])
  @@index([status])
}

model AdditionalProduct {
  id                    String    @id @default(cuid())
  name                  String
  unitType              UnitType  @default(DONA)
  defaultPrice          Float?
  defaultPriceCurrency  Currency  @default(UZS)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  orderItems            OrderAdditionalItem[]
}

model StockMovement {
  id               String           @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct   @relation(fields: [catalogProductId], references: [id])
  inventoryLotId   String?
  inventoryLot     InventoryLot?    @relation(fields: [inventoryLotId], references: [id])
  inventoryRollId  String?
  inventoryRoll    InventoryRoll?   @relation(fields: [inventoryRollId], references: [id])
  warehouseId      String
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  type             MovementType
  qty              Float
  cost             Float?
  currency         Currency         @default(UZS)
  reason           String?
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id])
  paymentMode      String?          // cash | debt
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([catalogProductId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([createdAt])
}

enum MovementType {
  IN
  OUT
  ADJUST
  WASTE
}

// ─────────────────────────────────────────────────────────────
//  Procurement (Shipments)
// ─────────────────────────────────────────────────────────────

model Shipment {
  id                 String           @id @default(cuid())
  supplierId         String
  supplier           Counterparty     @relation(fields: [supplierId], references: [id])
  containerNumber    String?
  status             ShipmentStatus   @default(IN_TRANSIT)
  shippingDate       DateTime?
  arrivalDate        DateTime?
  totalProductCost   Float            @default(0)
  totalExpenses      Float            @default(0)
  totalCost          Float            @default(0)
  currency           Currency         @default(UZS)
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items              ShipmentItem[]
  expenses           ShipmentExpense[]

  @@index([supplierId])
  @@index([status])
}

enum ShipmentStatus {
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

model ShipmentItem {
  id                     String          @id @default(cuid())
  shipmentId             String
  shipment               Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  catalogProductId       String?
  catalogProduct         CatalogProduct? @relation(fields: [catalogProductId], references: [id])
  productNameSnapshot    String
  quantity               Float
  unitPrice              Float
  totalPrice             Float
  currency               Currency        @default(UZS)
  widthMm                Float?
  lengthMm               Float?
  transferredToInventory Boolean         @default(false)
  createdAt              DateTime        @default(now())

  rolls                  InventoryRoll[]

  @@index([shipmentId])
}

model ShipmentExpense {
  id          String      @id @default(cuid())
  shipmentId  String
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  expenseType String      // customs | transport | unloading | labor | other
  amount      Float
  currency    Currency    @default(UZS)
  note        String?
  createdAt   DateTime    @default(now())

  @@index([shipmentId])
}

// ─────────────────────────────────────────────────────────────
//  Orders (unified: retail / wholesale / manufacturing / pos)
// ─────────────────────────────────────────────────────────────

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  proposalNumber        String?       @unique
  contractNumber        String?
  type                  OrderType     @default(RETAIL)
  status                OrderStatus   @default(YANGI_SOROV)
  priority              OrderPriority @default(NORMAL)
  channel               OrderChannel?
  fulfillmentType       FulfillmentType?

  clientId              String?
  client                Counterparty? @relation("OrderClient", fields: [clientId], references: [id])
  clientNameSnapshot    String?
  clientPhoneSnapshot   String?

  sellerEmployeeId      String?
  seller                Counterparty? @relation("OrderSeller", fields: [sellerEmployeeId], references: [id])
  assignedEmployeeId    String?
  assignedEmployee      Counterparty? @relation("OrderAssigned", fields: [assignedEmployeeId], references: [id])

  estimatedAmount       Float?
  agreedAmount          Float?
  paidAmount            Float         @default(0)
  discountPercent       Float         @default(0)
  discountAmount        Float         @default(0)
  totalAreaM2           Float?

  orderCurrency         Currency      @default(UZS)
  exchangeRateSnapshot  Float?
  taxRate               Float         @default(0)

  paymentType           PaymentType?
  scheduledAt           DateTime?
  expectedDeliveryDate  DateTime?
  deliveryAddress       String?
  nextFollowupAt        DateTime?
  followupNote          String?

  installmentMonthlyAmount Float?
  installmentStartDate     DateTime?
  installmentDueDay        Int?
  installmentMonths        Int?
  installmentNextPaymentDate DateTime?

  // Logistika (1-etap)
  driverName            String?
  driverPhone           String?
  driverCarNumber       String?
  deliveryCost          Float?
  deliveryCostCurrency  Currency? @default(UZS)
  deliveryPaidToId      String?
  deliveryPaidTo        Counterparty? @relation("OrderDeliveryPaidTo", fields: [deliveryPaidToId], references: [id])
  deliveryPaidAt        DateTime?
  deliveredAt           DateTime?
  receiverName          String?
  receiverPhone         String?
  receiverSignatureUrl  String?
  receiverConfirmedAt   DateTime?

  note                  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 OrderItem[]
  additionalItems       OrderAdditionalItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  paymentSchedule       PaymentSchedule?
  remnantsCreated       Remnant[]     @relation("SourceOrder")
  remnantsUsed          Remnant[]     @relation("UsedInOrder")
  stockMovements        StockMovement[]
  extraExpenses         CounterpartyExpense[]

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum OrderType {
  RETAIL
  WHOLESALE
  MANUFACTURING
  POS
}

// Merged state graph.  Which subset is legal is enforced by type in code
// (see src/lib/state-machine.ts).
enum OrderStatus {
  // Retail / Wholesale pipeline
  YANGI_SOROV
  MASLAHAT_BERILDI
  NARX_KELISHILDI
  BUYURTMA_OLINDI
  YETKAZILMOQDA
  YAKUNLANDI
  // Manufacturing pipeline
  PROPOSAL
  NEW
  PROCESSING
  READY
  DELIVERED
  // Terminal
  CANCELLED
}

enum OrderPriority {
  NORMAL
  HIGH
  VIP
}

enum OrderChannel {
  INSTAGRAM
  TELEGRAM
  PHONE
  WALK_IN
  WEBSITE
  OTHER
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentType {
  FULL
  PARTIAL
  DEFERRED
  INSTALLMENT
  NOT_CONFIRMED
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogProductId    String
  catalogProduct      CatalogProduct  @relation(fields: [catalogProductId], references: [id])
  productNameSnapshot String
  quantity            Float
  unitType            UnitType        @default(DONA)
  unitPrice           Float
  currency            Currency        @default(UZS)

  // Cut-specific (manufacturing)
  rollId              String?
  roll                InventoryRoll?  @relation(fields: [rollId], references: [id])
  widthMm             Float?
  lengthMm            Float?
  areaM2              Float?
  wasteAreaM2         Float?
  joiningMethod       String?

  createdAt           DateTime        @default(now())

  @@index([orderId])
  @@index([catalogProductId])
}

model OrderAdditionalItem {
  id                    String              @id @default(cuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  additionalProductId   String?
  additionalProduct     AdditionalProduct?  @relation(fields: [additionalProductId], references: [id])
  name                  String
  quantity              Float
  unitPrice             Float
  totalPrice            Float
  currency              Currency            @default(UZS)
  note                  String?
  createdAt             DateTime            @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedAt   DateTime     @default(now())
  reason      String?

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
//  Finance
// ─────────────────────────────────────────────────────────────

model Account {
  id           String       @id @default(cuid())
  name         String
  type         AccountType
  currency     Currency     @default(UZS)
  balanceCache Float        @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  payments     Payment[]
}

enum AccountType {
  CASH
  BANK
}

model TransactionCategory {
  id              String              @id @default(cuid())
  name            String              @unique
  type            String              // income | expense
  counterpartyMode String?            // mijoz | hodim | other
  createdAt       DateTime            @default(now())

  subcategories   TransactionSubcategory[]
  payments        Payment[]
}

model TransactionSubcategory {
  id          String              @id @default(cuid())
  categoryId  String
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime            @default(now())

  payments    Payment[]
}

model Payment {
  id                       String                   @id @default(cuid())
  date                     DateTime                 @default(now())
  type                     PaymentTxType
  accountId                String?
  account                  Account?                 @relation(fields: [accountId], references: [id])
  counterpartyId           String?
  counterparty             Counterparty?            @relation(fields: [counterpartyId], references: [id])
  counterpartyNameSnapshot String?

  amount                   Float
  currency                 Currency                 @default(UZS)
  exchangeRateSnapshot     Float?
  originalAmount           Float?
  originalCurrency         Currency?

  categoryId               String?
  category                 TransactionCategory?     @relation(fields: [categoryId], references: [id])
  subcategoryId            String?
  subcategory              TransactionSubcategory?  @relation(fields: [subcategoryId], references: [id])

  description              String?
  sourceType               PaymentSource
  sourceId                 String?
  sourceLabel              String?

  orderId                  String?
  order                    Order?                   @relation(fields: [orderId], references: [id])

  voidedAt                 DateTime?
  voidedById               String?
  voidedBy                 User?                    @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason               String?

  createdById              String?
  createdBy                User?                    @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt                DateTime                 @default(now())

  scheduleItemId           String?
  scheduleItem             PaymentScheduleItem?     @relation(fields: [scheduleItemId], references: [id])

  @@index([date])
  @@index([type])
  @@index([sourceType, sourceId])
  @@index([counterpartyId])
  @@index([orderId])
}

enum PaymentTxType {
  CASH_IN
  CASH_OUT
  BANK_IN
  BANK_OUT
  TRANSFER
}

enum PaymentSource {
  ORDER
  EXPENSE
  PAYROLL
  SUPPLIER_DEBT_PAYMENT
  SHIPMENT
  BATCH_RECEIVE
  PAYMENT_SCHEDULE
  LOAN
  FOUNDER_TX
  MANUAL
}

model PaymentSchedule {
  id             String                @id @default(cuid())
  orderId        String                @unique
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount    Float
  currency       Currency              @default(UZS)
  months         Int
  monthlyAmount  Float
  startDate      DateTime
  dueDay         Int
  createdAt      DateTime              @default(now())

  items          PaymentScheduleItem[]
}

model PaymentScheduleItem {
  id           String                    @id @default(cuid())
  scheduleId   String
  schedule     PaymentSchedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dueDate      DateTime
  amount       Float
  paidAmount   Float                     @default(0)
  status       PaymentScheduleItemStatus @default(PENDING)
  createdAt    DateTime                  @default(now())

  payments     Payment[]

  @@index([scheduleId])
  @@index([status, dueDate])
}

enum PaymentScheduleItemStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

// ─────────────────────────────────────────────────────────────
//  HR / Payroll / Attendance
// ─────────────────────────────────────────────────────────────

model Attendance {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [counterpartyId], onDelete: Cascade)
  clockIn       DateTime
  clockOut      DateTime?
  totalHours    Float?
  date          DateTime
  pauses        AttendancePause[]
  createdAt     DateTime            @default(now())

  @@index([employeeId])
  @@index([date])
}

model AttendancePause {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  pauseStart      DateTime
  pauseEnd        DateTime?
  durationMinutes Int?

  @@index([attendanceId])
}

model PayrollAccrual {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [counterpartyId], onDelete: Cascade)
  period      String   // YYYY-MM
  amount      Float
  currency    Currency @default(UZS)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, period])
}

// ─────────────────────────────────────────────────────────────
//  CRM
// ─────────────────────────────────────────────────────────────

model CrmStageConfig {
  id                     String     @id @default(cuid())
  funnel                 CrmFunnel
  stageKey               String
  label                  String
  order                  Int
  color                  String?
  isTerminal             Boolean    @default(false)
  requiresReason         Boolean    @default(false)
  requiresResaleDate     Boolean    @default(false)
  triggersOrderCreation  Boolean    @default(false)
  createdAt              DateTime   @default(now())

  reasons                CrmStageReason[]
  history                CrmStageHistory[]

  @@unique([funnel, stageKey])
}

enum CrmFunnel {
  LEAD
  BUYER
}

model CrmStageReason {
  id           String         @id @default(cuid())
  stageConfigId String
  stageConfig  CrmStageConfig @relation(fields: [stageConfigId], references: [id], onDelete: Cascade)
  reasonLabel  String
  createdAt    DateTime       @default(now())
}

model CrmStageHistory {
  id             String          @id @default(cuid())
  clientId       String
  client         Counterparty    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  funnel         CrmFunnel
  fromStage      String?
  toStage        String
  stageConfigId  String?
  stageConfig    CrmStageConfig? @relation(fields: [stageConfigId], references: [id])
  reason         String?
  changedBy      String?
  changedAt      DateTime        @default(now())

  @@index([clientId])
  @@index([changedAt])
}

model CallLog {
  id                String       @id @default(cuid())
  externalEventId   String?      @unique
  action            String       // call.start | call.answer | call.finish
  direction         String       // in | out
  phone             String
  clientId          String?
  client            Counterparty? @relation(fields: [clientId], references: [id])
  recordingUrl      String?
  rawPayload        Json?
  occurredAt        DateTime     @default(now())

  @@index([clientId])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────────
//  Notifications & Settings
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  type      NotificationType    @default(INFO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model UserDashboardSetting {
  userId               String @id
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibleCards         Json   @default("[]")
  warehouseColumnSettings Json? @default("{}")
  language             String @default("uz")
  updatedAt            DateTime @updatedAt
}

model FxRate {
  id           String   @id @default(cuid())
  base         Currency
  quote        Currency
  rate         Float
  effectiveAt  DateTime @default(now())

  @@index([base, quote, effectiveAt])
}

// ─────────────────────────────────────────────────────────────
//  Retsept (BOM) — polizol turiga qanday xomashyo ketishi
// ─────────────────────────────────────────────────────────────

model Recipe {
  id                String              @id @default(cuid())
  catalogProductId  String
  catalogProduct    CatalogProduct      @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  variantName       String              @default("Standart")
  outputQty         Float               @default(1)     // 1 rulon uchun
  outputUnit        UnitType            @default(DONA)
  laborCost         Float?              // donaga to'lov (masalan 3000 so'm/dona)
  laborCostCurrency Currency            @default(UZS)
  isActive          Boolean             @default(true)
  note              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  ingredients       RecipeIngredient[]

  @@unique([catalogProductId, variantName])
  @@index([catalogProductId])
}

model RecipeIngredient {
  id                    String            @id @default(cuid())
  recipeId              String
  recipe                Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialProductId     String
  materialProduct       CatalogProduct    @relation("RecipeMaterial", fields: [materialProductId], references: [id])
  quantity              Float
  unit                  UnitType
  wastePercent          Float             @default(0)  // chiqindi foizi
  createdAt             DateTime          @default(now())

  @@index([recipeId])
  @@index([materialProductId])
}

// ─────────────────────────────────────────────────────────────
//  Filial-ichki o'tkazma (mahsulot ko'chirish)
// ─────────────────────────────────────────────────────────────

model StockTransfer {
  id              String               @id @default(cuid())
  transferNumber  String               @unique
  fromWarehouseId String
  fromWarehouse   Warehouse            @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse            @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          TransferStatus       @default(PENDING)
  note            String?
  createdById     String?
  createdBy       User?                @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  items           StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransferItem {
  id                String        @id @default(cuid())
  transferId        String
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  catalogProductId  String
  catalogProduct    CatalogProduct @relation(fields: [catalogProductId], references: [id])
  quantity          Float
  unitType          UnitType

  @@index([transferId])
}

// ─────────────────────────────────────────────────────────────
//  Audit log
// ─────────────────────────────────────────────────────────────

model Log {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  screen      String
  action      LogAction
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([screen])
  @@index([userId])
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  LOGIN
  LOGOUT
  TRANSITION
  VOID
}
